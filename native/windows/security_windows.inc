/* Read the actual process user token. Guest pointers never contain host handles. */
#include <sddl.h>
static HANDLE security_tokens[32];
static HANDLE security_token(uint32_t h){unsigned i=(h-0xd5000000u)/4;if(h<0xd5000000u||(h&3)||i>=32||!security_tokens[i])rt_fatal("unmapped process token");return security_tokens[i];}
static void security_error(void){st32(rt_thread_self()->teb+0x34,GetLastError());}
static void open_process_token(X86Ctx*ctx){if(ARG(0)!=0xffffffff)rt_fatal("process token only for own process");HANDLE token=NULL;BOOL ok=OpenProcessToken(GetCurrentProcess(),ARG(1),&token);security_error();if(ok){for(unsigned i=0;i<32;i++)if(!security_tokens[i]){security_tokens[i]=token;st32(ARG(2),0xd5000000u+4*i);RET(1);return;}CloseHandle(token);rt_fatal("process token table full");}RET(ok);}
static void token_information(X86Ctx*ctx){if(ARG(1)!=TokenUser)rt_fatal("token information class %u not qualified",ARG(1));HANDLE token=security_token(ARG(0));DWORD needed=0;GetTokenInformation(token,TokenUser,NULL,0,&needed);void*b=malloc(needed);if(!b)rt_fatal("token query allocation");BOOL ok=GetTokenInformation(token,TokenUser,b,needed,&needed);if(ok){TOKEN_USER*u=b;DWORD sidlen=GetLengthSid(u->User.Sid),guestlen=8+sidlen;st32(ARG(4),guestlen);if(ARG(3)<guestlen||!ARG(2)){SetLastError(ERROR_INSUFFICIENT_BUFFER);ok=FALSE;}else{uint32_t g=ARG(2);st32(g,g+8);st32(g+4,u->User.Attributes);memcpy(rt_ptr(g+8),u->User.Sid,sidlen);}}security_error();free(b);RET(ok);}
static void sid_string(X86Ctx*ctx){char*s=NULL;BOOL ok=ConvertSidToStringSidA((PSID)rt_ptr(ARG(0)),&s);security_error();if(ok){size_t n=strlen(s)+1;uint32_t g=rt_heap_alloc(n,0);memcpy(rt_ptr(g),s,n);LocalFree(s);st32(ARG(1),g);}RET(ok);}
static void close_handle(X86Ctx*ctx){uint32_t h=ARG(0);if(h>=0xd5000000u&&h<0xd5000080u&&!(h&3)){unsigned i=(h-0xd5000000u)/4;BOOL ok=CloseHandle(security_tokens[i]);security_error();security_tokens[i]=NULL;RET(ok);return;}extern void rt_file_close(uint32_t);rt_file_close(h);rt_handle_close(h);RET(1);}
